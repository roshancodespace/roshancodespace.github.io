---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
	const posts = await getCollection("blog");

	return posts.map((post) => ({
		params: {
			slug: post.id,
		},
		props: {
			post,
		},
	}));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout
	title={`${post.data.title} — Roshan Kumar`}
	description={post.data.description}
>
	<article class="mx-auto max-w-3xl px-6 pt-32 pb-32 sm:px-10">
		<nav class="mb-20">
			<a
				href="/blog"
				class="text-[11px] font-medium uppercase tracking-widest text-[var(--muted-foreground)] transition-colors hover:text-[var(--foreground)]"
			>
				&larr; All Writings
			</a>
		</nav>

		<header class="mb-12">
			<div
				class="mb-6 flex items-center text-[10px] font-semibold uppercase tracking-widest text-[var(--muted-foreground)]"
			>
				<time datetime={post.data.pubDate.toISOString()}>
					{
						post.data.pubDate.toLocaleDateString("en-US", {
							month: "short",
							day: "numeric",
							year: "numeric",
						})
					}
				</time>
				{
					post.data.tags.length > 0 && (
						<>
							<span class="mx-3 text-[var(--border)]">
								&middot;
							</span>
							<span>{post.data.tags.join(" \u00B7 ")}</span>
						</>
					)
				}
			</div>

			<h1
				class="mb-6 text-4xl font-semibold tracking-tight text-[var(--foreground)] sm:text-5xl lg:text-6xl"
			>
				{post.data.title}
			</h1>

			<p
				class="text-xl font-light leading-relaxed text-[var(--muted-foreground)] sm:text-2xl"
			>
				{post.data.description}
			</p>
		</header>

		<div class="border-t border-[var(--border)] pt-8">
			<div
				class="prose-content space-y-6 text-base font-light leading-relaxed text-[var(--foreground)] sm:text-lg"
			>
				<Content />
			</div>
		</div>
	</article>
</BaseLayout>

<style>
	.prose-content :global(p) {
		margin-top: 1.5rem;
		line-height: 1.8;
		opacity: 0.8;
	}
	.prose-content :global(h3) {
		font-size: 1.5rem;
		font-weight: 500;
		color: var(--foreground);
		margin-top: 3.5rem;
		margin-bottom: 1rem;
		letter-spacing: -0.01em;
	}
	.prose-content :global(ul) {
		list-style-type: none;
		padding-left: 0;
		margin-top: 1.5rem;
		margin-bottom: 1.5rem;
		opacity: 0.8;
	}
	.prose-content :global(li) {
		margin-top: 0.5rem;
		position: relative;
		padding-left: 1.5rem;
	}
	.prose-content :global(li::before) {
		content: "-";
		position: absolute;
		left: 0;
		color: var(--muted-foreground);
	}
	.prose-content :global(pre) {
		padding: 1.5rem;
		border-radius: var(--radius-card);
		overflow-x: auto;
		margin-top: 2.5rem;
		margin-bottom: 2.5rem;
		border: 1px solid var(--border);
	}
	.prose-content :global(:not(pre) > code) {
		font-family: var(--font-mono);
		font-size: 0.85em;
		background: var(--muted);
		padding: 0.15rem 0.35rem;
		border-radius: var(--radius-code);
		color: var(--foreground);
	}
	.prose-content :global(strong) {
		font-weight: 600;
		color: var(--foreground);
	}
	.prose-content :global(em) {
		font-style: italic;
	}
</style>
