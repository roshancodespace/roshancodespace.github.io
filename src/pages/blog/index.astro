---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

const posts = (await getCollection("blog")).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

function formatTitle(title: string) {
	return title.replace(
		/`([^`]+)`/g,
		'<code class="font-mono text-[0.75em] bg-white/10 border border-white/10 px-2 py-0.5 rounded-md text-white/90 font-normal inline-block align-middle my-0.5 tracking-normal">$1</code>',
	);
}
---

<BaseLayout
	title="Blog — Roshan Kumar"
	description="Writings on Flutter, Dart, Linux, Android internals, and software engineering."
>
	<div class="mx-auto max-w-4xl px-6 pt-32 pb-32 sm:px-10">
		<header class="mb-14 space-y-2">
			<h1
				class="text-3xl font-semibold tracking-tight text-white sm:text-4xl"
			>
				Writings
			</h1>
			<p class="text-sm text-white/50">
				Thoughts on engineering, breaking things, and building software
				that doesn't waste resources.
			</p>
		</header>

		<div class="divide-y divide-white/10 border-y border-white/10">
			{
				posts.map((post) => {
					const wordCount = post.body
						? post.body.trim().split(/\s+/).length
						: 500;
					const readingTime = Math.max(1, Math.ceil(wordCount / 220));

					return (
						<a
							href={`/blog/${post.id}`}
							class="group block py-8 transition-colors hover:text-white"
						>
							<div class="flex items-center justify-between text-xs text-white/40">
								<div class="flex items-center gap-2 font-mono">
									<time
										datetime={post.data.pubDate.toISOString()}
									>
										{post.data.pubDate.toLocaleDateString(
											"en-US",
											{
												month: "short",
												day: "numeric",
												year: "numeric",
											},
										)}
									</time>
									<span>&middot;</span>
									<span class="text-white/30">
										{readingTime} min read
									</span>
								</div>

								<div class="flex items-center gap-1.5">
									{post.data.tags.map((tag) => (
										<span class="rounded bg-white/5 px-2 py-0.5 text-[10px] text-white/60">
											{tag}
										</span>
									))}
								</div>
							</div>

							<h2
								class="mt-3 text-xl font-medium tracking-tight text-white/90 group-hover:text-white transition-colors"
								set:html={formatTitle(post.data.title)}
							/>

							<p class="mt-2 text-sm leading-relaxed text-white/50">
								{post.data.description}
							</p>

							<div class="mt-4 flex items-center text-xs text-white/40 group-hover:text-white transition-colors gap-1">
								<span>Read article</span>
								<span class="transition-transform group-hover:translate-x-1">
									&rarr;
								</span>
							</div>
						</a>
					);
				})
			}
		</div>
	</div>
</BaseLayout>
