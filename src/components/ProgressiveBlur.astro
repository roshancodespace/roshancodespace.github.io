		position: fixed;
		left: 0;
		right: 0;
		pointer-events: none;
		user-select: none;
		overflow: hidden;
	}

	.progressive-blur-top {
		top: 0;
		height: 7.5rem; /* 120px */
		z-index: 40;
	}

	@media (min-width: 640px) {
		.progressive-blur-top {
			height: 8.5rem; /* 136px */
		}
	}

	.progressive-blur-bottom {
		bottom: 0;
