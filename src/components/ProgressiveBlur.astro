---
interface Props {
	position?: "top" | "bottom";
	className?: string;
}

const { position = "top", className = "" } = Astro.props;
const isTop = position === "top";
const persistKey = isTop ? "progressive-blur-top" : "progressive-blur-bottom";
---

<div
	class={`progressive-blur ${isTop ? "progressive-blur-top" : "progressive-blur-bottom"} ${className}`}
	aria-hidden="true"
	transition:persist={persistKey}
>
	<div class="blur-layer layer-1"></div>
	<div class="blur-layer layer-2"></div>
	<div class="blur-layer layer-3"></div>
	<div class="blur-layer layer-4"></div>
	<div class="blur-layer layer-5"></div>
	<div class="blur-layer layer-6"></div>
	<div class="blur-layer layer-7"></div>
	<div class="blur-layer layer-8"></div>
	<div class="gradient-layer"></div>
</div>

