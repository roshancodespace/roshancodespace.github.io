---
interface Props {
	bladeCount?: number;
	maxHeight?: number;
	windSpeed?: number;
	windStrength?: number;
	glowOpacity?: number;
	glowX?: number;
	glowY?: number;
	groundElevation?: number;
	layerOffset?: number;
	seedheadProbability?: number;
	interactive?: boolean;
	grainOpacity?: number;
}

const {
	bladeCount = 210,
	maxHeight = 1.0,
	windSpeed = 1.0,
	windStrength = 1.0,
	glowOpacity = 1.0,
	glowX = 0.82,
	glowY = 0.92,
	groundElevation = 0.95,
	layerOffset = 8,
	seedheadProbability = 0.3,
	interactive = true,
	grainOpacity = 0.035,
} = Astro.props;

const config = JSON.stringify({
	bladeCount,
	maxHeight,
	windSpeed,
	windStrength,
	glowOpacity,
	glowX,
	glowY,
	groundElevation,
	layerOffset,
	seedheadProbability,
	interactive,
	grainOpacity,
});
---

<div
	id="hero-grass-container"
	class="pointer-events-none absolute inset-0 -z-10 overflow-hidden select-none"
	aria-hidden="true"
	data-config={config}
>
	<canvas id="hero-grass-canvas" class="h-full w-full block"></canvas>

	<svg
		class="pointer-events-none absolute inset-0 h-full w-full mix-blend-screen"
		style={`opacity: ${grainOpacity}`}
		xmlns="http://www.w3.org/2000/svg"
	>
		<filter id="hero-grass-grain">
			<feTurbulence
				type="fractalNoise"
				baseFrequency="0.8"
				numOctaves="4"
				stitchTiles="stitch"></feTurbulence>
			<feColorMatrix type="saturate" values="0"></feColorMatrix>
		</filter>
		<rect width="100%" height="100%" filter="url(#hero-grass-grain)"></rect>
	</svg>
</div>

<script>
	interface GrassConfig {
		bladeCount: number;
		maxHeight: number;
		windSpeed: number;
		windStrength: number;
		glowOpacity: number;
		glowX: number;
		glowY: number;
		groundElevation: number;
		layerOffset: number;
		seedheadProbability: number;
		interactive: boolean;
		grainOpacity: number;
	}

	interface Blade {
		baseXRatio: number;
		heightRatio: number;
		naturalLean: number;
		bowAmount: number;
		baseWidth: number;
		stiffness: number;
		phase: number;
		speed: number;
		layer: number;
		hasSeedhead: boolean;
		colorType: number;
		currentDeflection: number;
	}

	interface ThemeColors {
		glowCenter: string;
		glowMid: string;
		glowOuter: string;
		groundBack: string;
		groundMid: string;
		bladeColors: string[];
	}

	function initHeroGrass() {
		const container = document.getElementById(
			"hero-grass-container",
		) as HTMLElement | null;
		if (!container) return;

		const canvas = document.getElementById(
			"hero-grass-canvas",
		) as HTMLCanvasElement | null;
		if (!canvas) return;

		const ctx = canvas.getContext("2d");
		if (!ctx) return;

		const cvs: HTMLCanvasElement = canvas;
		const g: CanvasRenderingContext2D = ctx;

		const rawConfig = container.dataset.config;
		const cfg: GrassConfig = rawConfig
			? JSON.parse(rawConfig)
			: {
					bladeCount: 210,
					maxHeight: 1.0,
					windSpeed: 1.0,
					windStrength: 1.0,
					glowOpacity: 1.0,
					glowX: 0.82,
					glowY: 0.92,
					groundElevation: 0.95,
					layerOffset: 8,
					seedheadProbability: 0.3,
					interactive: true,
					grainOpacity: 0.035,
				};

		let width = 0;
		let height = 0;
		let animationFrameId: number | null = null;
		let isVisible = true;
		let blades: Blade[] = [];

		function getThemeColors(): ThemeColors {
			const target = document.documentElement;
			const style = getComputedStyle(target);

			const accentRaw =
				style.getPropertyValue("--accent").trim() ||
				"oklch(0.4429 0.0444 134.5073)";
			const primaryRaw =
				style.getPropertyValue("--primary").trim() ||
				"oklch(0.7830 0.0384 132.7370)";
			const bgRaw =
				style.getPropertyValue("--background").trim() ||
				"oklch(0.1173 0.0090 73.4751)";
			const mutedRaw =
				style.getPropertyValue("--muted").trim() ||
				"oklch(0.2203 0.0129 77.9565)";
			const fgRaw =
				style.getPropertyValue("--foreground").trim() ||
				"oklch(0.9796 0.0017 67.8026)";

			const withAlpha = (color: string, alpha: number): string => {
				const scaledAlpha = Math.max(0, Math.min(1, alpha));
				if (color.includes("oklch")) {
					return color.replace(/\s*\)\s*$/, ` / ${scaledAlpha})`);
				}
				return `color-mix(in srgb, ${color} ${Math.round(scaledAlpha * 100)}%, transparent)`;
			};

			return {
				glowCenter: withAlpha(accentRaw, 0.35 * cfg.glowOpacity),
				glowMid: withAlpha(accentRaw, 0.14 * cfg.glowOpacity),
				glowOuter: withAlpha(bgRaw, 0),
				groundBack: withAlpha(mutedRaw, 0.55),
				groundMid: withAlpha(mutedRaw, 0.85),
				bladeColors: [
					withAlpha(accentRaw, 0.45),
					withAlpha(primaryRaw, 0.42),
					withAlpha(mutedRaw, 0.6),
					withAlpha(fgRaw, 0.3),
					withAlpha(fgRaw, 0.16),
				],
			};
		}

		let theme = getThemeColors();

		const mouse = {
			x: -1000,
			y: -1000,
			targetX: -1000,
			targetY: -1000,
			vx: 0,
			lastX: -1000,
			isOver: false,
		};

		const reducedMotionMq = window.matchMedia(
			"(prefers-reduced-motion: reduce)",
		);
		let prefersReducedMotion = reducedMotionMq.matches;

		reducedMotionMq.addEventListener("change", (e) => {
			prefersReducedMotion = e.matches;
			if (prefersReducedMotion) {
				if (animationFrameId !== null) {
					cancelAnimationFrame(animationFrameId);
					animationFrameId = null;
				}
				drawFrame(0);
			} else {
				startLoop();
			}
		});

		function getGroundY(x: number, layer: number): number {
			const nx = width > 0 ? x / width : 0;
			const baseElevation =
				height * cfg.groundElevation -
				Math.pow(nx, 1.6) * (height * 0.08) +
				Math.sin(nx * 4) * 6;
			const offset = (layer - 1) * cfg.layerOffset;
			return baseElevation + offset;
		}

		function generateBlades() {
			blades = [];
			const isMobile = width < 768;
			const totalCount = isMobile
				? Math.round(cfg.bladeCount * 0.55)
				: cfg.bladeCount;

			const clumps = isMobile
				? [
						{
							cx: 0.04,
							share: 0.08,
							maxH: 0.04 * cfg.maxHeight,
							spread: 0.1,
							lean: -2,
						},
						{
							cx: 0.18,
							share: 0.12,
							maxH: 0.05 * cfg.maxHeight,
							spread: 0.14,
							lean: -1,
						},
						{
							cx: 0.38,
							share: 0.18,
							maxH: 0.07 * cfg.maxHeight,
							spread: 0.15,
							lean: 4,
						},
						{
							cx: 0.62,
							share: 0.22,
							maxH: 0.1 * cfg.maxHeight,
							spread: 0.16,
							lean: 9,
						},
						{
							cx: 0.82,
							share: 0.24,
							maxH: 0.12 * cfg.maxHeight,
							spread: 0.16,
							lean: 13,
						},
						{
							cx: 0.96,
							share: 0.16,
							maxH: 0.1 * cfg.maxHeight,
							spread: 0.1,
							lean: 16,
						},
					]
				: [
						{
							cx: 0.03,
							share: 0.04,
							maxH: 0.035 * cfg.maxHeight,
							spread: 0.08,
							lean: -3,
						},
						{
							cx: 0.11,
							share: 0.05,
							maxH: 0.04 * cfg.maxHeight,
							spread: 0.1,
							lean: -3,
						},
						{
							cx: 0.22,
							share: 0.06,
							maxH: 0.045 * cfg.maxHeight,
							spread: 0.12,
							lean: -2,
						},
						{
							cx: 0.34,
							share: 0.07,
							maxH: 0.05 * cfg.maxHeight,
							spread: 0.12,
							lean: -2,
						},
						{
							cx: 0.46,
							share: 0.08,
							maxH: 0.065 * cfg.maxHeight,
							spread: 0.12,
							lean: 2,
						},
						{
							cx: 0.58,
							share: 0.1,
							maxH: 0.085 * cfg.maxHeight,
							spread: 0.12,
							lean: 5,
						},
						{
							cx: 0.7,
							share: 0.14,
							maxH: 0.11 * cfg.maxHeight,
							spread: 0.12,
							lean: 9,
						},
						{
							cx: 0.8,
							share: 0.17,
							maxH: 0.14 * cfg.maxHeight,
							spread: 0.12,
							lean: 12,
						},
						{
							cx: 0.9,
							share: 0.17,
							maxH: 0.16 * cfg.maxHeight,
							spread: 0.12,
							lean: 15,
						},
						{
							cx: 0.98,
							share: 0.12,
							maxH: 0.14 * cfg.maxHeight,
							spread: 0.08,
							lean: 18,
						},
					];

			clumps.forEach((clump) => {
				const count = Math.max(1, Math.round(totalCount * clump.share));
				for (let i = 0; i < count; i++) {
					const xRatio = Math.max(
						0.0,
						Math.min(
							1.0,
							clump.cx + (Math.random() - 0.5) * clump.spread,
						),
					);

					const layerRand = Math.random();
					const layer =
						layerRand < 0.28 ? 0 : layerRand < 0.72 ? 1 : 2;

					const hRatio = clump.maxH * (0.55 + Math.random() * 0.45);

					const fan = (Math.random() - 0.35) * 14;
					const naturalLean = clump.lean + fan + (hRatio / 0.17) * 12;
					const bowAmount =
						naturalLean * 0.5 + (Math.random() - 0.3) * 8;

					const baseWidth =
						layer === 0
							? 1.4 + Math.random() * 0.6
							: layer === 1
								? 1.8 + Math.random() * 0.8
								: 2.2 + Math.random() * 1.0;

					blades.push({
						baseXRatio: xRatio,
						heightRatio: hRatio,
						naturalLean,
						bowAmount,
						baseWidth,
						stiffness: 0.7 + Math.random() * 0.6,
						phase: Math.random() * Math.PI * 2,
						speed: 0.55 + Math.random() * 0.75,
						layer,
						hasSeedhead:
							layer >= 1 &&
							hRatio > 0.11 * cfg.maxHeight &&
							Math.random() < cfg.seedheadProbability,
						colorType: Math.floor(
							Math.random() * theme.bladeColors.length,
						),
						currentDeflection: 0,
					});
				}
			});

			blades.sort((a, b) => a.layer - b.layer);
		}

		function resize() {
			if (!container || !cvs || !g) return;
			const rect = container.getBoundingClientRect();
			width = Math.floor(rect.width);
			height = Math.floor(rect.height);

			if (width === 0 || height === 0) return;

			const dpr = Math.min(window.devicePixelRatio || 1, 2);
			cvs.width = Math.floor(width * dpr);
			cvs.height = Math.floor(height * dpr);
			g.setTransform(1, 0, 0, 1, 0, 0);
			g.scale(dpr, dpr);

			theme = getThemeColors();
			generateBlades();

			if (prefersReducedMotion) {
				drawFrame(0);
			}
		}

		function drawGroundLayer(layerIndex: number, fillColor: string) {
			g.beginPath();
			g.moveTo(-10, height + 20);
			for (let x = -10; x <= width + 20; x += 15) {
				g.lineTo(x, getGroundY(x, layerIndex));
			}
			g.lineTo(width + 20, height + 20);
			g.closePath();
			g.fillStyle = fillColor;
			g.fill();
		}

		function drawFrame(timestamp: number) {
			if (!cvs || !g || width === 0 || height === 0) return;

			g.clearRect(0, 0, width, height);

			const t = timestamp * 0.001 * cfg.windSpeed;

			const glowX = width * cfg.glowX;
			const glowY = height * cfg.glowY;
			const glowRadius = Math.max(width * 0.55, 480);
			const glow = g.createRadialGradient(
				glowX,
				glowY,
				15,
				glowX,
				glowY,
				glowRadius,
			);
			glow.addColorStop(0, theme.glowCenter);
			glow.addColorStop(0.4, theme.glowMid);
			glow.addColorStop(1, theme.glowOuter);

			g.fillStyle = glow;
			g.fillRect(0, 0, width, height);

			drawGroundLayer(0, theme.groundBack);

			if (cfg.interactive) {
				mouse.x += (mouse.targetX - mouse.x) * 0.08;
				mouse.y += (mouse.targetY - mouse.y) * 0.08;
				mouse.vx = mouse.x - mouse.lastX;
				mouse.lastX = mouse.x;
			}

			const globalWind =
				(Math.sin(t * 0.45) * 0.5 +
					Math.sin(t * 0.95 + 1.2) * 0.25 +
					Math.cos(t * 0.22) * 0.3) *
				cfg.windStrength;

			let currentLayer = -1;

			for (let i = 0; i < blades.length; i++) {
				const b = blades[i];

				if (b.layer !== currentLayer) {
					currentLayer = b.layer;
					if (currentLayer === 1) {
						drawGroundLayer(1, theme.groundMid);
					}
				}

				const baseX = b.baseXRatio * width;
				const baseY = getGroundY(baseX, b.layer);
				const bladeH = b.heightRatio * height;

				let windSway = 0;
				if (!prefersReducedMotion) {
					const localWind =
						(Math.sin(
							t * b.speed + b.phase + (baseX / width) * 3.5,
						) *
							0.65 +
							Math.sin(t * 1.5 + b.phase) * 0.22 +
							globalWind) *
						cfg.windStrength;

					const targetDeflection = localWind * 16 * b.stiffness;

					let mouseForce = 0;
					if (cfg.interactive && mouse.isOver) {
						const dist = Math.abs(baseX - mouse.x);
						if (dist < 160) {
							const proximity = 1 - dist / 160;
							mouseForce =
								proximity *
								Math.sign(mouse.vx || 1) *
								Math.min(Math.abs(mouse.vx) * 1.1, 16);
						}
					}

					b.currentDeflection +=
						(targetDeflection + mouseForce - b.currentDeflection) *
						0.08;
					windSway = b.currentDeflection;
				}

				const lean = b.naturalLean + windSway;
				const bow = b.bowAmount + windSway * 0.45;

				const tipX = baseX + lean;
				const tipY = baseY - bladeH + Math.abs(windSway) * 0.12;
				const ctrlX = baseX + bow;
				const ctrlY = baseY - bladeH * 0.55;

				const halfW = b.baseWidth * 0.5;

				g.beginPath();
				g.moveTo(baseX - halfW, baseY);
				g.quadraticCurveTo(ctrlX - halfW * 0.25, ctrlY, tipX, tipY);
				g.quadraticCurveTo(
					ctrlX + halfW * 0.25,
					ctrlY,
					baseX + halfW,
					baseY,
				);
				g.closePath();

				const bladeColor =
					theme.bladeColors[b.colorType % theme.bladeColors.length];
				g.fillStyle = bladeColor;
				g.fill();

				if (b.hasSeedhead && bladeH > 65 * cfg.maxHeight) {
					const rAngle = Math.atan2(tipY - ctrlY, tipX - ctrlX);
					const reedLen = 14 + (bladeH / height) * 80;
					const reedEndX = tipX + Math.cos(rAngle) * reedLen;
					const reedEndY = tipY + Math.sin(rAngle) * reedLen;

					g.beginPath();
					g.moveTo(tipX, tipY);
					g.lineTo(reedEndX, reedEndY);
					g.strokeStyle = bladeColor;
					g.lineWidth = 1.1;
					g.lineCap = "round";
					g.stroke();

					for (let s = 1; s <= 3; s++) {
						const frac = s / 4;
						const sx = tipX + (reedEndX - tipX) * frac;
						const sy = tipY + (reedEndY - tipY) * frac;
						const side = s % 2 === 0 ? 1 : -1;
						const tx = sx + Math.cos(rAngle + 1.2 * side) * 3.5;
						const ty = sy + Math.sin(rAngle + 1.2 * side) * 3.5;

						g.beginPath();
						g.moveTo(sx, sy);
						g.lineTo(tx, ty);
						g.lineWidth = 0.6;
						g.stroke();
					}
				}
			}
		}

		function loop(timestamp: number) {
			if (!isVisible || prefersReducedMotion) return;
			drawFrame(timestamp);
			animationFrameId = requestAnimationFrame(loop);
		}

		function startLoop() {
			if (
				animationFrameId === null &&
				isVisible &&
				!prefersReducedMotion
			) {
				animationFrameId = requestAnimationFrame(loop);
			}
		}

		function stopLoop() {
			if (animationFrameId !== null) {
				cancelAnimationFrame(animationFrameId);
				animationFrameId = null;
			}
		}

		const heroSection = container.closest("section");
		const targetEl = heroSection || window;

		const onMouseMove = (e: MouseEvent) => {
			if (!cvs) return;
			const rect = cvs.getBoundingClientRect();
			mouse.targetX = e.clientX - rect.left;
			mouse.targetY = e.clientY - rect.top;
			mouse.isOver = true;
		};

		const onMouseLeave = () => {
			mouse.isOver = false;
			mouse.targetX = -1000;
			mouse.targetY = -1000;
		};

		if (cfg.interactive) {
			targetEl.addEventListener(
				"mousemove",
				onMouseMove as EventListener,
				{
					passive: true,
				},
			);
			targetEl.addEventListener(
				"mouseleave",
				onMouseLeave as EventListener,
				{
					passive: true,
				},
			);
		}

		const observer = new IntersectionObserver(
			(entries) => {
				for (const entry of entries) {
					isVisible = entry.isIntersecting;
					if (isVisible) {
						startLoop();
					} else {
						stopLoop();
					}
				}
			},
			{ threshold: 0.05 },
		);

		if (heroSection) {
			observer.observe(heroSection);
		}

		document.addEventListener("visibilitychange", () => {
			if (document.hidden) {
				stopLoop();
			} else if (isVisible) {
				startLoop();
			}
		});

		const resizeObserver = new ResizeObserver(() => {
			resize();
		});
		resizeObserver.observe(container);

		resize();
		startLoop();
	}

	if (document.readyState === "loading") {
		document.addEventListener("DOMContentLoaded", initHeroGrass);
	} else {
		initHeroGrass();
	}
	document.addEventListener("astro:page-load", initHeroGrass);
</script>
