---
import type {
	Project,
	ProjectCardLayout,
	ProjectCardSpan,
} from "../lib/projects";

interface Props {
	project: Project;
	layout?: ProjectCardLayout;
	span?: ProjectCardSpan;
	class?: string;
}

const { project: entry, class: className = "" } = Astro.props;
const project = entry.data;
const href = `/projects/${entry.id}`;

const requestedLayout = Astro.props.layout ?? project.cardLayout;
const layout: ProjectCardLayout =
	requestedLayout === "split" && project.image ? "split" : "stacked";
const isSplit = layout === "split";

const span: ProjectCardSpan =
	Astro.props.span ?? project.cardSpan ?? (isSplit ? 2 : 1);

const spanClasses: Record<ProjectCardSpan, string> = {
	1: "",
	2: "sm:col-span-2",
	3: "sm:col-span-2 lg:col-span-3",
};
---

<a
	href={href}
	data-layout={layout}
	class:list={[
		"group relative flex flex-col justify-between h-full w-full overflow-hidden rounded-card border border-white/10 bg-white/[0.02] p-6 transition-all duration-300 hover:border-white/20 hover:bg-white/[0.035]",
		spanClasses[span],
		className,
	]}
>
	{
		isSplit && project.image && (
			<div class="pointer-events-none absolute inset-0 overflow-hidden rounded-card">
				{project.accentColor && (
					<div
						class="absolute -top-16 -right-16 h-64 w-64 rounded-full blur-3xl opacity-15 transition-opacity duration-500 group-hover:opacity-25"
						style={`background-color: ${project.accentColor};`}
					/>
				)}

				<div
					class="absolute inset-y-0 right-0 h-full w-full sm:w-[60%] lg:w-[55%] overflow-hidden"
					style="
						mask-image: linear-gradient(115deg, transparent 0%, rgba(0, 0, 0, 0.1) 20%, rgba(0, 0, 0, 0.6) 60%, black 100%);
						-webkit-mask-image: linear-gradient(115deg, transparent 0%, rgba(0, 0, 0, 0.1) 20%, rgba(0, 0, 0, 0.6) 60%, black 100%);
					"
				>
					<img
						src={project.image}
						alt={project.title}
						class="h-full w-full object-cover object-right sm:object-center opacity-30 transition-all duration-700 ease-out group-hover:scale-105 group-hover:opacity-50"
						loading="lazy"
					/>
					<div class="absolute inset-0 bg-gradient-to-r from-black/80 via-black/20 to-transparent pointer-events-none" />
				</div>
			</div>
		)
	}

	<div
		class="relative z-10 flex items-center justify-between gap-4 text-xs text-white/40"
	>
		<span class="uppercase tracking-widest font-medium">
			{project.category}
		</span>
		<span class="shrink-0">{project.year}</span>
	</div>

	{
		!isSplit && project.image && (
			<div class="relative z-10 my-4 aspect-[16/10] w-full overflow-hidden rounded-media border border-white/10 bg-black/40">
				<img
					src={project.image}
					alt={project.title}
					class="h-full w-full object-cover object-top transition-transform duration-500 ease-out group-hover:scale-[1.03]"
					loading="lazy"
				/>
			</div>
		)
	}

	<div
		class:list={[
			"relative z-10 flex-1",
			!isSplit && project.image ? "mt-4" : "mt-6",
			isSplit && "sm:max-w-[54%] lg:max-w-[56%] sm:py-2",
		]}
	>
		<div class="flex items-baseline justify-between gap-4">
			<h3
				class:list={[
					"font-medium tracking-tight text-white/95 transition-colors group-hover:text-white",
					isSplit ? "text-xl sm:text-2xl" : "text-xl",
				]}
			>
				{project.title}
			</h3>
			{
				project.stars && (
					<span class="flex shrink-0 items-center gap-1 text-xs text-white/40">
						&starf; {project.stars}
					</span>
				)
			}
		</div>

		{
			isSplit && project.tagline && (
				<p class="mt-2 text-sm text-white/75 leading-relaxed font-normal">
					{project.tagline}
				</p>
			)
		}

		<p class="mt-2 text-sm leading-relaxed text-white/50">
			{project.description}
		</p>
	</div>

	<div
		class="relative z-10 mt-6 flex items-center justify-between gap-4 border-t border-white/5 pt-4 text-xs text-white/35"
	>
		<div class="flex flex-wrap items-center gap-2">
			{
				project.languages.map((lang, idx) => (
					<span>
						{lang}
						{idx < project.languages.length - 1 && " ·"}
					</span>
				))
			}
		</div>

		<span
			class="shrink-0 transition-transform duration-200 group-hover:translate-x-1 group-hover:text-white"
		>
			&rarr;
		</span>
	</div>
</a>
